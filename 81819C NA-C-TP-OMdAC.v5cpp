{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START V5 MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END V5 MACROS\n\n\n// Robot configuration code.\ncontroller Controller1 = controller(primary);\ncontroller Controller2 = controller(partner);\nmotor MotorGroupLMotorA = motor(PORT8, ratio18_1, true);\nmotor MotorGroupLMotorB = motor(PORT10, ratio18_1, true);\nmotor_group MotorGroupL = motor_group(MotorGroupLMotorA, MotorGroupLMotorB);\n\nmotor MotorGroupRMotorA = motor(PORT1, ratio18_1, false);\nmotor MotorGroupRMotorB = motor(PORT3, ratio18_1, false);\nmotor_group MotorGroupR = motor_group(MotorGroupRMotorA, MotorGroupRMotorB);\n\nmotor MotorL = motor(PORT9, ratio18_1, true);\n\nmotor MotorR = motor(PORT2, ratio18_1, false);\n\nmotor MotorB = motor(PORT4, ratio6_1, false);\n\nmotor MotorT = motor(PORT6, ratio6_1, false);\n\nmotor MotorSPED = motor(PORT7, ratio18_1, true);\n\nmotor MotorOut = motor(PORT5, ratio18_1, true);\n\ndigital_out Pneumatic = digital_out(Brain.ThreeWirePort.H);\ndigital_out Hijack = digital_out(Brain.ThreeWirePort.G);\ninertial InertialSensor = inertial(PORT19);\n\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  int systemTime = Brain.Timer.systemHighResolution();\n  double batteryCurrent = Brain.Battery.current();\n  double batteryVoltage = Brain.Battery.voltage(voltageUnits::mV);\n\n  // Combine these values into a single integer\n  int seed = int(batteryVoltage + batteryCurrent * 100) + systemTime;\n\n  // Set the seed\n  srand(seed);\n}\n\n\n\nvoid vexcodeInit() {\n\n  //Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// Helper to make playing sounds from the V5 in VEXcode easier and\n// keeps the code cleaner by making it clear what is happening.\nvoid playVexcodeSound(const char *soundName) {\n  printf(\"VEXPlaySound:%s\\n\", soundName);\n  wait(5, msec);\n}\n\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n// Include the V5 Library\n#include \"vex.h\"\n  \n// Allows for easier use of the VEX Library\nusing namespace vex;\n\ncompetition Competition;\n\nint motorSpedUp = 1;\ndouble intakeVelocity = 100.0;\n\nvoid printStatus() {\n  while (true) {\n    Controller2.Screen.setCursor(0, 0);\n    if (motorSpedUp == 0) {\n      Controller2.Screen.print(\"Blocks go out\");\n    } else {\n      Controller2.Screen.print(\"Blocks go up\");\n    }\n\n    Controller2.Screen.newLine();\n\n    if (intakeVelocity == 100.0) {\n      Controller2.Screen.print(\"Intake normal speed\");\n    } else {\n      Controller2.Screen.print(\"Intake slower\");\n    }\n    wait(0.2, seconds);\n    Controller2.Screen.clearScreen();\n  }\n}\n\nvoid preAuton() {\n  vexcodeInit();\n}\n\nvoid autonomous() {\n  int a = 0;\n}\n\nvoid userControl(void) {\n    // Controller 1: Split arcade with straight on left\n  //               R1 to open / close pneumatics\n  //               L1 to activate / deactivate hijack (descoring)\n  \n  // Controller 2: L1 & L2 for intake / outtake\n  //               R1 & R2 for middle\n  //               A to change the direction of the SPED motor\n  //               X to make the intake slower / normal\n\n  thread printTheSpedValue {printStatus};\n\n  int aPressedBefore = 0;\n  int r1PressedBefore = 0;\n  int l1PressedBefore = 0;\n  int xPressedBefore = 0;\n\n  int pneumaticStatus = 0;\n  int hijackStatus = 0;\n\n  double turningVelocity = 90.0;\n\n  // Velocities\n  double prev = 0;\n  double out = 0;\n  int vdl = 40; // Velocity difference limit\n\n  Brain.Screen.print(\"C-TP-OMdAC\");\n\n  MotorT.setVelocity(0, percent);\n  MotorB.setVelocity(0, percent);\n  MotorSPED.setVelocity(0, percent);\n\n  while (true) {\n    if (fabs(Controller1.Axis3.position() - prev) > vdl) {\n      if (Controller1.Axis3.position() < prev) { \n        out = prev - vdl;\n      } else {\n        out = prev + vdl;\n      }\n    } else {\n      out = Controller1.Axis3.position();\n    }\n    prev = out;\n    \n    MotorGroupL.setVelocity(out + (turningVelocity / 100.0) * Controller1.Axis1.position(), percent);\n    MotorGroupR.setVelocity(out - (turningVelocity / 100.0) * Controller1.Axis1.position(), percent);\n\n    MotorGroupL.spin(forward);\n    MotorGroupR.spin(forward);\n\n    if (Controller2.ButtonL1.pressing()) {\n      MotorB.setVelocity(100 * intakeVelocity / 100.0, percent); \n      MotorSPED.setVelocity(motorSpedUp * 100, percent);\n      MotorOut.setVelocity(100, percent);\n    } else if (Controller2.ButtonL2.pressing()) {\n      MotorB.setVelocity(-100 * intakeVelocity / 100.0, percent);\n      MotorSPED.setVelocity(motorSpedUp * 100, percent);\n      MotorOut.setVelocity(-100, percent);\n    } else {\n      MotorB.setVelocity(0, percent);\n      MotorSPED.setVelocity(0, percent);\n      MotorOut.setVelocity(0, percent);\n    }\n\n    if (Controller2.ButtonR1.pressing()) {\n      MotorT.setVelocity(100, percent); \n    } else if (Controller2.ButtonR2.pressing()) {\n      MotorT.setVelocity(-100, percent);\n    } else {\n      MotorT.setVelocity(0, percent);\n    }\n\n    if (Controller2.ButtonA.pressing()) {\n      if (aPressedBefore == 0) {\n        if (motorSpedUp == 1) {\n          motorSpedUp = 0;\n        } else {\n          motorSpedUp = 1;\n        };\n      }\n      aPressedBefore = 1;\n    } else {\n      aPressedBefore = 0;\n    }\n    \n    MotorB.spin(forward);\n    MotorT.spin(forward);\n    MotorSPED.spin(forward);\n    MotorOut.spin(forward);\n\n    if (Controller1.ButtonR1.pressing()) {\n      if (r1PressedBefore == 0) {\n        if (pneumaticStatus == 1) {\n          pneumaticStatus = 0;\n        } else {\n          pneumaticStatus = 1;\n        }\n      }\n      r1PressedBefore = 1;\n    } else {\n      r1PressedBefore = 0;\n    }\n\n    if (pneumaticStatus == 0) {\n      Pneumatic.set(false);\n    } else {\n      Pneumatic.set(true);\n    }\n\n    if (Controller1.ButtonL1.pressing()) {\n      if (l1PressedBefore == 0) {\n        if (hijackStatus == 1) {\n          hijackStatus = 0;\n        } else {\n          hijackStatus = 1;\n        }\n      }\n      l1PressedBefore = 1;\n    } else {\n      l1PressedBefore = 0;\n    }\n\n    if (hijackStatus == 0) {\n      Hijack.set(false);\n    } else {\n      Hijack.set(true);\n    }\n\n    if (Controller2.ButtonX.pressing()) {\n      if (xPressedBefore == 0) {\n        if (intakeVelocity == 100.0) {\n          intakeVelocity = 50.0;\n        } else {\n          intakeVelocity = 100.0;\n        }\n      }\n      xPressedBefore = 1;\n    } else {\n      xPressedBefore = 0;\n    }\n\n    wait(20, msec);\n  }\n}\n\nint main() {\n  Competition.drivercontrol(userControl);\n\n  preAuton();\n  autonomous():\n  userControl();\n\n  while (true) {\n    wait(100, msec);\n  }\n}","textLanguage":"cpp","robotConfig":[{"port":[],"name":"Controller1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[],"name":"Controller2","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"partner"},"triportSourcePort":22},{"port":[8,10],"name":"MotorGroupL","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","gear":"ratio18_1","motor_a_reversed":"true","motor_b_reversed":"true"},"triportSourcePort":22},{"port":[1,3],"name":"MotorGroupR","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","gear":"ratio18_1","motor_a_reversed":"false","motor_b_reversed":"false","id":"partner"},"triportSourcePort":22},{"port":[9],"name":"MotorL","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[2],"name":"MotorR","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[4],"name":"MotorB","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio6_1"},"triportSourcePort":22},{"port":[6],"name":"MotorT","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio6_1"},"triportSourcePort":22},{"port":[7],"name":"MotorSPED","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[5],"name":"MotorOut","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"},"triportSourcePort":22},{"port":[8],"name":"Pneumatic","customName":true,"deviceType":"DigitalOut","deviceClass":"digital_out","setting":{"id":"partner"},"triportSourcePort":22},{"port":[7],"name":"Hijack","customName":true,"deviceType":"DigitalOut","deviceClass":"digital_out","setting":{"id":"partner"},"triportSourcePort":22},{"port":[19],"name":"InertialSensor","customName":true,"deviceType":"Inertial","deviceClass":"inertial","setting":{"id":"partner"},"triportSourcePort":22}],"slot":6,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.62.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}